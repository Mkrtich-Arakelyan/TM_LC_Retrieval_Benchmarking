# Copy to .env and fill all three values. Never put a real key in this example.
# Provider: openai or gemini. Use an API model ID available in your account.
TM_LLM_PROVIDER=
TM_LLM_MODEL=
TM_API_KEY=

# Fixed reviewed operations only; generated Python and hardware stay disabled.
TM_REVIEWED_NUMERICS_ENABLED=true
